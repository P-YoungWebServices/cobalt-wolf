<?xml version="1.0" encoding="utf-8"?>
<!-- The session and saved server profiles (including encrypted access tokens) must never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="server_profiles.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="server_profiles.xml" />
    </device-transfer>
</data-extraction-rules>
