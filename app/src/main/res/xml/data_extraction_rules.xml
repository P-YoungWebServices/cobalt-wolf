<?xml version="1.0" encoding="utf-8"?>
<!-- The session, saved server profiles and service API keys (all encrypted) must never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="server_profiles.xml" />
        <exclude domain="sharedpref" path="arr_settings.xml" />
        <exclude domain="sharedpref" path="qbittorrent_settings.xml" />
        <exclude domain="sharedpref" path="qbittorrent_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="server_profiles.xml" />
        <exclude domain="sharedpref" path="arr_settings.xml" />
        <exclude domain="sharedpref" path="qbittorrent_settings.xml" />
        <exclude domain="sharedpref" path="qbittorrent_session.xml" />
    </device-transfer>
</data-extraction-rules>
