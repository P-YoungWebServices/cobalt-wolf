<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds only: entry points for testing playback from adb on devices without a TV
         layout (Fire TV) or a server. See README "Testing playback". Never part of release builds. -->
    <application>
        <activity-alias
            android:name=".player.DebugPlayerActivity"
            android:exported="true"
            android:targetActivity=".player.PlayerActivity" />

        <activity-alias
            android:name=".ui.settings.DebugPlaybackSettingsActivity"
            android:exported="true"
            android:targetActivity=".ui.settings.PlaybackSettingsActivity" />
    </application>

</manifest>
