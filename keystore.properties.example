# Release signing configuration. Copy to `keystore.properties` (gitignored)
# and fill in the real values. Generate the keystore once with:
#
#   keytool -genkey -v -keystore release.keystore -alias cobaltwolf \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Path is resolved relative to the repository root.
storeFile=release.keystore
storePassword=
keyAlias=cobaltwolf
keyPassword=
